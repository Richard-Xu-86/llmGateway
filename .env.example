# Copy to .env. Every value below has a working default, so the gateway runs
# against the mock upstream with no configuration at all.

GATEWAY_PORT=4000

# Point at the mock (default) or at https://api.openai.com for real calls.
UPSTREAM_BASE_URL=http://localhost:4010

# Only needed when UPSTREAM_BASE_URL is the real OpenAI API.
# This key is held server-side and is never logged, stored, or returned.
OPENAI_API_KEY=sk-replace-me

# Gateway keys issued to callers: name:key,name:key
GATEWAY_API_KEYS=demo-app:gw_live_demo_key_1,agent-runner:gw_live_demo_key_2

# memory | http   (http ships logs to the backend; memory keeps them in-process)
LOG_SINK=memory
BACKEND_INGEST_URL=http://localhost:4020/ingest
INGEST_SECRET=dev-secret

MOCK_PORT=4010
